# Meet Interview environment variables

# ── AI (Google Gemini) ──────────────────────────────────────────────
# The app runs fully WITHOUT a key (heuristic engine). Add a key for real AI.
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# CALLBACK_MODEL_TAILOR=gemini-2.5-pro
# CALLBACK_MODEL_ANALYZE=gemini-2.5-flash

# ── Auth (better-auth) ──────────────────────────────────────────────
# Required. Generate a long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Database (NeonDB — serverless Postgres) ─────────────────────────
# Create a project at https://neon.tech and copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Social login (optional) ─────────────────────────────────────────
# Google: https://console.cloud.google.com  → OAuth client (Web)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Cloudinary (DOCX hosting for resume/cover downloads) ─────────────
# Optional: without these, downloads fall back to a base64 data URI.
# Get them at https://console.cloudinary.com (Dashboard → Product Environment).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
